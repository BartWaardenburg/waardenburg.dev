{
	"name": "waardenburg.dev",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.25.0",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"build:analyze": "ANALYZE=true next build --webpack",
		"postbuild": "next-sitemap",
		"start": "next start",
		"type-check": "tsc --noEmit",
		"lint": "oxlint --tsconfig=tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"generate:favicons": "node scripts/generate-favicons.mjs",
		"prepare": "husky",
		"remotion:preview": "remotion studio remotion/index.ts",
		"remotion:render": "remotion render remotion/index.ts PromoVideo out/promo-video.mp4"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@remotion/cli": "^4.0.441",
		"@remotion/google-fonts": "^4.0.441",
		"@remotion/transitions": "^4.0.441",
		"clsx": "^2.1.1",
		"dompurify": "^3.3.3",
		"motion": "^12.38.0",
		"next": "^16.2.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"remotion": "^4.0.441",
		"shiki": "^4.0.2",
		"tailwind-merge": "^3.5.0"
	},
	"devDependencies": {
		"@next/bundle-analyzer": "^16.2.1",
		"@tailwindcss/postcss": "^4.2.2",
		"@types/node": "^25.5.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"next-sitemap": "^4.2.3",
		"oxlint": "^1.57.0",
		"png-to-ico": "^3.0.1",
		"postcss": "^8.5.8",
		"prettier": "^3.8.1",
		"schema-dts": "^2.0.0",
		"sharp": "^0.34.5",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs}": [
			"oxlint --tsconfig=tsconfig.json",
			"prettier --write"
		],
		"*.{json,md,yml,yaml,css,d.ts}": [
			"prettier --write"
		]
	}
}
