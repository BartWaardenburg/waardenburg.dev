{
	"name": "waardenburg.dev",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.25.0",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"build:analyze": "ANALYZE=true next build --webpack",
		"postbuild": "next-sitemap",
		"start": "next start",
		"type-check": "tsc --noEmit",
		"lint": "oxlint --tsconfig=tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"generate:favicons": "node scripts/generate-favicons.mjs",
		"prepare": "husky"
	},
	"dependencies": {
		"lenis": "^1.3.26",
		"motion": "^12.43.0",
		"next": "^16.3.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@next/bundle-analyzer": "^16.3.6",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^25.9.8",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"next-sitemap": "^4.2.3",
		"oxlint": "^1.86.0",
		"png-to-ico": "^3.0.2",
		"postcss": "^8.5.28",
		"prettier": "^3.9.9",
		"schema-dts": "^2.0.0",
		"sharp": "^0.34.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs}": [
			"oxlint --tsconfig=tsconfig.json",
			"prettier --write"
		],
		"*.{json,md,yml,yaml,css,d.ts}": [
			"prettier --write"
		]
	}
}
